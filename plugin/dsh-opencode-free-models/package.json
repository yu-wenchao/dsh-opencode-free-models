{
  "name": "dsh-opencode-free-models",
  "version": "0.1.0",
  "description": "OpenCode Zen 免费模型面板插件：实时展示 OpenCode Zen 最新免费模型，一键置入 DSH 模型选择器，无需密钥即用（共享字面量密钥由宿主注入）。后台支持总开关 / 单模型下架管理。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./client.js": "./lib/client.js",
    "./lib/client.js": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/plugin.test.js",
    "verify": "node scripts/build.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "opencode",
    "free-models",
    "model-provider"
  ],
  "author": "dsh-opencode-free-models authors",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
